<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sentry_bringup</name>
  <version>0.0.0</version>
  <description>Sentry navigation bringup: launch / nav2_params / EKF / maps / URDF / scripts</description>
  <maintainer email="2514802580@qq.com">nobita</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行时依赖：启动脚本与节点 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- 依赖的其他 ROS 包 -->
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>point_lio</exec_depend>
  <exec_depend>cpp_lidar_filter</exec_depend>
  <exec_depend>fake_vel_transform</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>small_gicp_relocalization</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
